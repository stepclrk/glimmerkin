{
  "name": "glimmerkin-server",
  "private": true,
  "version": "0.1.0",
  "description": "Serves the Glimmerkin game. Accounts and saves arrive in later slices.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"test/*.test.js\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "fastify": "^5.2.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.0"
  }
}
