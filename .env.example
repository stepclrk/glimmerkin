# Settings for this server. Do not edit this file: run "sh setup.sh", which creates .env from it and fills
# in the secrets. Then change .env if you need to.

# Which address on this server answers on port 7777.
#   0.0.0.0     every address: reachable from your network at http://<server>:7777
#   127.0.0.1   this server only: use this when cloudflared runs directly on this server (not in a
#               container), so the port is off the rest of the network
BIND_ADDRESS=0.0.0.0

# The database password. setup.sh makes a random one. It is fixed the first time the stack starts:
# changing it afterwards locks the server out of its own database.
POSTGRES_PASSWORD=

# Backups. One is made each night, encrypted with BACKUP_PASSPHRASE, and 14 days are kept.
# setup.sh makes a random passphrase. KEEP A COPY OF IT SOMEWHERE ELSE: a backup cannot be read without it,
# and if this server is lost the passphrase is lost with it.
BACKUP_PASSPHRASE=

# Where backups are written. The default is a folder beside this file, which is still on this server.
# Point it at storage that is not this server (a mounted NAS share, a synced folder) to survive losing it.
BACKUP_DIR=./backups

# The hour, in UTC, at which the nightly backup runs.
BACKUP_HOUR=3
